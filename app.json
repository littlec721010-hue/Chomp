{
  "expo": {
    "name": "Chomp",
    "slug": "chomp",
    "scheme": "chomp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fff8f4",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a receipt photo to split your bill.",
          "cameraPermission": "Take a receipt photo to split your bill.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
